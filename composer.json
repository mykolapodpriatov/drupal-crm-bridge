{
    "name": "mykolapodpriatov/crm_bridge",
    "description": "Queue-backed bidirectional sync between Drupal 11 entities and a CRM (HubSpot, Twenty): idempotent writes, origin tagging, signed webhooks, conflict policies and a Drush drift audit.",
    "type": "drupal-module",
    "license": "MIT",
    "keywords": [
        "Drupal",
        "drupal-module",
        "crm",
        "hubspot",
        "integration",
        "sync"
    ],
    "homepage": "https://github.com/mykolapodpriatov/drupal-crm-bridge",
    "authors": [
        {
            "name": "Mykola Podpriatov",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/mykolapodpriatov/drupal-crm-bridge/issues",
        "source": "https://github.com/mykolapodpriatov/drupal-crm-bridge"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "drupal/core": "^10.3 || ^11"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "mglaman/phpstan-drupal": "^1.2 || ^2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.10 || ^2",
        "phpstan/phpstan-deprecation-rules": "^1.1 || ^2",
        "phpstan/phpstan-phpunit": "^1.3 || ^2",
        "phpunit/phpunit": "^9.6 || ^10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist src tests",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist src tests",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:kernel": "phpunit --testsuite=kernel",
        "test:functional": "phpunit --testsuite=functional"
    }
}
